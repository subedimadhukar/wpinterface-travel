{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpitravel/trip-itinerary",
	"title": "Trip Itinerary",
	"category": "wpitravel",
	"icon": "list-view",
	"description": "Day-by-day itinerary.",
	"keywords": [
		"itinerary",
		"days"
	],
	"textdomain": "wpinterface-travel",
	"attributes": {
		"tripId": {
			"type": "integer",
			"default": 0
		},
		"open": {
			"type": "boolean",
			"default": false
		}
	},
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "wpitravel-blocks-editor",
	"editorStyle": [
		"wpitravel-blocks-editor",
		"wpitravel-frontend"
	]
}
