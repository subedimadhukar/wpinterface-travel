includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
	level: 6
	paths:
		- wpinterface-travel.php
		- uninstall.php
		- src
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	treatPhpDocTypesAsCertain: false
	excludePaths:
		# Elementor widgets extend Elementor's classes, which are not installed here.
		# Elementor.php (the loader) is still analysed.
		- src/Elementor/Widget.php
		- src/Elementor/*Widget.php
	ignoreErrors:
		# Generated by `npm run build` and not committed, so missing in a fresh checkout.
		-
			identifier: require.fileNotFound
			message: '#assets/build/[a-z-]+\.asset\.php#'
			reportUnmatched: false
