{
	"name": "wpinterface-travel",
	"version": "0.9.0",
	"private": true,
	"description": "WPInterface Travel WordPress plugin.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js assets/src",
		"lint:css": "wp-scripts lint-style \"assets/src/**/*.scss\"",
		"format": "wp-scripts format assets/src",
		"env": "wp-env",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/wpinterface-travel vendor/bin/phpunit",
		"i18n:pot": "wp i18n make-pot . languages/wpinterface-travel.pot --exclude=node_modules,vendor,assets/src,tests,dist,docs --headers='{\"Report-Msgid-Bugs-To\":\"https://wordpress.org/support/plugin/wpinterface-travel/\"}'",
		"plugin-zip": "wp-scripts plugin-zip"
	},
	"files": [
		"assets/build",
		"assets/css",
		"assets/src",
		"blocks",
		"languages",
		"src",
		"templates",
		"package.json",
		"webpack.config.js",
		"readme.txt",
		"uninstall.php",
		"wpinterface-travel.php"
	],
	"devDependencies": {
		"@wordpress/api-fetch": "^7.0.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/compose": "^8.10.0",
		"@wordpress/core-data": "^8.2.0",
		"@wordpress/data": "^10.57.0",
		"@wordpress/dom-ready": "^4.57.0",
		"@wordpress/editor": "^15.2.0",
		"@wordpress/element": "^9.0.0",
		"@wordpress/env": "^10.0.0",
		"@wordpress/i18n": "^6.30.0",
		"@wordpress/icons": "^18.0.0",
		"@wordpress/media-utils": "^5.57.0",
		"@wordpress/scripts": "^30.0.0",
		"@wordpress/url": "^4.57.0",
		"typescript": "^5.9.3"
	}
}
